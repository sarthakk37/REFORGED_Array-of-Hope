# DriftSmith Frontend Environment Configuration

# Backend API base URL for real mode (VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8000

# Run UI completely in mock mode (in-memory mock store and simulated event streams)
# Options: true | false (default: true)
VITE_USE_MOCK=true

# Voice narration mode for the guided presenter demo (Priya story)
# Options: speech (browser SpeechSynthesis) | audio (pre-recorded audio files) | off (captions only)
# Default: speech
VITE_NARRATION=speech
