# DriftSmith Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database (defaults to SQLite in backend/data/)
DATABASE_URL=sqlite:///./data/driftsmith.db

# Authentication
AUTH_ENABLED=true
JWT_SECRET=demo-secret-key-change-in-production
JWT_EXPIRY_MINUTES=1440
DEMO_PASSWORD=password
API_KEY=drift-secret-key-42

# AI / LLM Configuration
LLM_MODE=mock
GEMINI_API_KEY=
GEMMA_MODEL_DIAG=gemma-2-9b-it
GEMMA_MODEL_CODE=gemma-2-27b-it

# Demo Target & Mock Provider
DEMO_TARGETS_PATH=../demo
PROVIDER_URL=http://localhost:9000

# Integrations (optional; defaults to dry-run when empty)
GITHUB_TOKEN=
GITHUB_REPO=
SLACK_WEBHOOK_URL=
N8N_WEBHOOK_URL=
SANDBOX_TIMEOUT_SECONDS=30
